syntax = "v1"

info (
	title:   "AI Workbench Callback"
	desc:    "只承载第三方以 HTTP 推送的回调（Lark 卡片交互）。业务接口一律走 gRPC，见 app/rpc/workbench.proto"
	author:  "rex"
	version: "v1"
)

type (
	LarkCallbackReq {
		Body map[string]interface{} `json:"body,optional"` // 原始回调体由 handler 验签后解析
	}
	LarkCallbackResp {
		Toast map[string]interface{} `json:"toast,optional"`
		Card  map[string]interface{} `json:"card,optional"`
	}
)

@server (
	prefix: /callback/v1
	group:  lark
)
service callback-api {
	@doc "Lark 卡片交互回调：验签 -> open_id 映射 -> 按任务表鉴权 -> 调用 RunService.Signal"
	@handler LarkCallback
	post /lark (LarkCallbackReq) returns (LarkCallbackResp)
}
