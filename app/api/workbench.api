syntax = "v1"

info (
	title:   "AI Workbench API"
	desc:    "任务中心、工作流引擎与 Lark 回调的 HTTP 入口。设计见 docs/ai-task-platform.md 与 docs/workflow-engine.md"
	author:  "rex"
	version: "v1"
)

// ---------------------------------------------------------------------------
// 工作流运行（引擎 API）
// ---------------------------------------------------------------------------
type (
	StartRunReq {
		PlanId  string                 `json:"planId"`
		BizKey  string                 `json:"bizKey"`            // 业务幂等键，如 task:<taskId>
		Trigger map[string]interface{} `json:"trigger,optional"`  // 触发数据
		DryRun  bool                   `json:"dryRun,optional"`
	}
	StartRunResp {
		RunId       int64 `json:"runId"`
		PlanVersion int   `json:"planVersion"`
		Created     bool  `json:"created"` // false = bizKey 已存在，返回已有 run
	}
	SignalReq {
		RunId     int64                  `path:"runId"`
		NodeId    string                 `json:"nodeId"`
		Iteration int                    `json:"iteration"`
		Option    string                 `json:"option"`            // 人工选择的端口
		Form      map[string]interface{} `json:"form,optional"`     // 必填项、备注、snooze 时长等
	}
	SignalResp {
		Accepted bool   `json:"accepted"`
		Reason   string `json:"reason,optional"` // 被拒绝时的原因，卡片上即时提示
	}
	CancelRunReq {
		RunId  int64  `path:"runId"`
		Reason string `json:"reason"`
	}
	GetRunReq {
		RunId int64 `path:"runId"`
	}
	NodeView {
		NodeId     string `json:"nodeId"`
		Iteration  int    `json:"iteration"`
		Status     string `json:"status"`
		Port       string `json:"port"`
		Attempt    int    `json:"attempt"`
		StartedAt  string `json:"startedAt"`
		FinishedAt string `json:"finishedAt"`
	}
	RunView {
		RunId       int64      `json:"runId"`
		PlanId      string     `json:"planId"`
		PlanVersion int        `json:"planVersion"`
		Status      string     `json:"status"`
		Nodes       []NodeView `json:"nodes"`
	}
	AdminNodeReq {
		RunId  int64  `path:"runId"`
		NodeId string `json:"nodeId"`
		Port   string `json:"port,optional"` // skip 时指定以哪个端口完成
		Reason string `json:"reason"`
	}
	EmptyResp {}
)

@server (
	prefix: /api/v1
	group:  run
)
service workbench-api {
	@doc "启动 workflow 运行（按 bizKey 幂等）"
	@handler StartRun
	post /runs (StartRunReq) returns (StartRunResp)

	@doc "向等待中的人工节点发送选择（按任务表鉴权）"
	@handler Signal
	post /runs/:runId/signal (SignalReq) returns (SignalResp)

	@doc "取消运行（如源工单离开 Maker Review Case）"
	@handler CancelRun
	post /runs/:runId/cancel (CancelRunReq) returns (EmptyResp)

	@doc "查询运行状态，供运行态画布着色"
	@handler GetRun
	get /runs/:runId (GetRunReq) returns (RunView)

	@doc "人工干预：重试节点"
	@handler RetryNode
	post /runs/:runId/retry (AdminNodeReq) returns (EmptyResp)

	@doc "人工干预：以指定端口跳过节点"
	@handler SkipNode
	post /runs/:runId/skip (AdminNodeReq) returns (EmptyResp)
}

// ---------------------------------------------------------------------------
// 任务中心
// ---------------------------------------------------------------------------
type (
	TaskView {
		Id           int64                  `json:"id"`
		TaskType     string                 `json:"taskType"`
		Status       int                    `json:"status"`   // -1 unassigned / 0 pending / 1 processing / 2 snoozed / 3 solved
		Priority     int                    `json:"priority"` // 0 P0 ... 3 P3
		AssigneeId   string                 `json:"assigneeId"`
		CurrentNode  string                 `json:"currentNode"`
		Resolution   string                 `json:"resolution"`
		SlaStatus    string                 `json:"slaStatus"`
		SnoozeUntil  string                 `json:"snoozeUntil"`
		DueAt        string                 `json:"dueAt"`
		Payload      map[string]interface{} `json:"payload"` // 已按查看者脱敏
		UpdatedAt    string                 `json:"updatedAt"`
	}
	GetTaskReq {
		Id int64 `path:"id"`
	}
	ListMyTasksReq {
		Status   []int  `form:"status,optional"`
		Cursor   string `form:"cursor,optional"`
		PageSize int    `form:"pageSize,default=20"`
	}
	ListMyTasksResp {
		Items      []TaskView `json:"items"`
		NextCursor string     `json:"nextCursor"`
	}
	ClaimTaskReq {
		Id int64 `path:"id"`
	}
	StartProcessingReq {
		Id int64 `path:"id"`
	}
	UpdatePriorityReq {
		Id       int64  `path:"id"`
		Priority int    `json:"priority,range=[0:3]"`
		Reason   string `json:"reason"`
	}
	ReassignReq {
		Id         int64  `path:"id"`
		AssigneeId string `json:"assigneeId"`
		Reason     string `json:"reason"`
	}
)

@server (
	prefix: /api/v1
	group:  task
)
service workbench-api {
	@doc "任务详情"
	@handler GetTask
	get /tasks/:id (GetTaskReq) returns (TaskView)

	@doc "我的任务列表，按优先级、截止时间排序"
	@handler ListMyTasks
	get /tasks (ListMyTasksReq) returns (ListMyTasksResp)

	@doc "认领组任务（unassigned -> pending，CAS）"
	@handler ClaimTask
	post /tasks/:id/claim (ClaimTaskReq) returns (TaskView)

	@doc "开始处理（pending -> processing，不影响流程）"
	@handler StartProcessing
	post /tasks/:id/start (StartProcessingReq) returns (TaskView)

	@doc "调整优先级（需权限，原因必填，写 Task Event）"
	@handler UpdatePriority
	post /tasks/:id/priority (UpdatePriorityReq) returns (TaskView)

	@doc "转派（只改变处理人，状态不变）"
	@handler Reassign
	post /tasks/:id/reassign (ReassignReq) returns (TaskView)
}

// ---------------------------------------------------------------------------
// 配置：编译、试运行、发布
// ---------------------------------------------------------------------------
type (
	CompileReq {
		Dsl map[string]interface{} `json:"dsl"`
	}
	CompileIssue {
		NodeId  string `json:"nodeId,optional"`
		EdgeId  string `json:"edgeId,optional"`
		Code    string `json:"code"`
		Message string `json:"message"`
	}
	CompileResp {
		Ok     bool           `json:"ok"`
		Issues []CompileIssue `json:"issues"`
	}
	DryRunReq {
		Dsl     map[string]interface{}   `json:"dsl"`
		Samples []map[string]interface{} `json:"samples"`         // 历史事件样本或手工 payload
		Choices map[string]string        `json:"choices,optional"` // 人工节点预设选择：nodeId -> option
	}
	DryRunResp {
		Report map[string]interface{} `json:"report"`
	}
	PublishPlanReq {
		PlanId string                 `json:"planId"`
		Dsl    map[string]interface{} `json:"dsl"`
	}
	PublishPlanResp {
		PlanId  string `json:"planId"`
		Version int    `json:"version"`
	}
)

@server (
	prefix: /api/v1
	group:  plan
)
service workbench-api {
	@doc "编译并校验 DSL，不保存"
	@handler CompilePlan
	post /plans/compile (CompileReq) returns (CompileResp)

	@doc "试运行：复用编译器与推进器，动作节点只记录不执行"
	@handler DryRunPlan
	post /plans/dry-run (DryRunReq) returns (DryRunResp)

	@doc "发布新版本（审批通过后调用；已发布版本不可修改）"
	@handler PublishPlan
	post /plans/publish (PublishPlanReq) returns (PublishPlanResp)
}

// ---------------------------------------------------------------------------
// Lark 回调
// ---------------------------------------------------------------------------
type (
	LarkCallbackReq {
		Body map[string]interface{} `json:"body,optional"` // 原始回调体由 handler 验签后解析
	}
	LarkCallbackResp {
		Toast map[string]interface{} `json:"toast,optional"`
		Card  map[string]interface{} `json:"card,optional"`
	}
)

@server (
	prefix: /api/v1
	group:  lark
)
service workbench-api {
	@doc "Lark 卡片交互回调：验签 -> open_id 映射 -> 按任务表鉴权 -> Signal"
	@handler LarkCallback
	post /lark/callback (LarkCallbackReq) returns (LarkCallbackResp)
}
